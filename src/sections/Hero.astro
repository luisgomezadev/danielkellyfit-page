---
import { Image } from "astro:assets";
import { WHATSAPP_NUMBER } from "@/data/constans.ts";
import heroImg from "@/assets/images/daniel_hero_section.webp";

const { id } = Astro.props;
const WHATSAPP_URL = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
  "Hola Daniel, vi tu página web y me gustaría recibir información sobre tus planes de entrenamiento.",
)}`;
---

<section
  id={id}
  class="relative scroll-mt-30 overflow-hidden text-accent bg-neutral-700 min-h-screen flex items-end"
>
  <div
    class="grid lg:grid-cols-2 gap-x-12 items-end w-full max-w-[89rem] mx-auto px-4 md:px-6 pb-12 pt-32 lg:py-0 min-h-screen z-20"
  >
    <!-- Overlays de degradado globales -->
    <div
      class="absolute inset-0 z-10 bg-gradient-to-t from-background-secondary via-background-secondary/95 via-45% to-background-secondary/50 block lg:hidden pointer-events-none"
    >
    </div>

    <div
      class="absolute inset-0 z-30 bg-gradient-to-t from-background-secondary via-background-secondary via-5% to-background-secondary/50 hidden lg:block pointer-events-none"
    >
    </div>

    <div
      class="absolute bottom-0 right-0 hidden lg:block z-10 w-[60%] h-[35%] md:h-[60%] bg-gradient-to-tl from-primary/35 via-primary/15 to-transparent blur-[100px] pointer-events-none transform translate-x-10 translate-y-10"
    >
    </div>

    <header class="z-40 flex flex-col justify-end pt-[22rem] md:pt-12 lg:pb-16">
      <span
        class="text-primary font-medium text-xs tracking-widest block mb-4 uppercase"
      >
        Especialista en hipertrofia y desarrollo muscular - coach online y
        presencial VIP
      </span>

      <h1
        class="text-[6rem] sm:text-[7rem] md:text-[130px] font-bold tracking-normal leading-[.9] mb-4 uppercase font-display"
      >
        Daniel<br />
        <span class="text-primary">Kelly</span>
      </h1>

      <p class="font-display text-2xl md:text-4xl opacity-65 tracking-wider">
        #TEAMDANIELKELLY
      </p>

      <p
        class="pl-4 border-l-4 border-primary text-sm md:text-base font-normal mt-6 mb-8"
      >
        <strong
          >"Te ayudo a conseguir el cuerpo de tus sueños en solo 12 semanas."</strong
        >
      </p>

      <div class="flex flex-row flex-wrap items-center gap-4">
        <a
          href={WHATSAPP_URL}
          class="w-fit bg-primary text-background-theme py-3 px-6 inline-block transition-all duration-300 hover:bg-primary/90 uppercase tracking-widest font-bold text-sm text-center"
          target="_blank"
          rel="noopener noreferrer"
        >
          Quiero mi transformación
        </a>
        <a
          href="#estrategias"
          class="w-fit font-semibold transition-all duration-300 py-3 px-6 inline-block hover:text-primary uppercase tracking-widest text-sm border border-primary/50 text-center"
        >
          Ver estrategias
        </a>
      </div>
    </header>

    <div
      class="absolute lg:relative inset-0 lg:inset-auto lg:h-screen flex items-end justify-center z-0 lg:z-10 overflow-hidden pointer-events-none"
    >
      <Image
        src={heroImg}
        alt="Foto de Daniel Kelly"
        width={761}
        height={1140}
        widths={[360, 540, 761]}
        sizes="(max-width: 1024px) 100vw, 761px"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        format="webp"
        quality={65}
        class="object-contain h-[85%] lg:h-[130vh] max-w-none select-none opacity-60 lg:opacity-90 grayscale-[.3] lg:grayscale lg:-mb-[35vh] -top-24 lg:top-auto relative"
      />
    </div>
  </div>
</section>
