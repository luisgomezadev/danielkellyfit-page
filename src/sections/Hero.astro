---
import ButtonSocialLink from '@/components/ButtonSocialLink.astro';
import FacebooIcon from '@/assets/icons/FacebookIcon.astro';
import InstagramIcon from '@/assets/icons/InstagramIcon.astro';
import TikTokIcon from '@/assets/icons/TikTokIcon.astro';

const { id } = Astro.props;
---

<section id={id} class="scroll-mt-30 bg-gradient-to-r from-black to-green-950 text-white relative">
  <div
    class="relative grid lg:grid-cols-2 gap-x-12 gap-y-24 items-center lg:min-h-screen max-w-7xl mx-auto md:px-3 px-4 pt-36 pb-12 lg:py-8"
  >
    <header class="z-30 max-w-xl mx-auto lg:text-start text-center">
      <div>
        <h1 class="text-5xl md:text-6xl font-bold tracking-wide mb-3">
          Entrenador Personal & Creador de Contenido
        </h1>
        <p class="text-base md:text-lg opacity-80 text-pretty lg:text-start">
          Te guío en tu transformación física y mental con planes de entrenamiento y nutrición
          personalizados, pensados para que avances de forma segura y consigas resultados reales.
        </p>

        <p class="text-sm md:text-base text-pretty italic mt-2 text-primary lg:text-start">
          - Si vas al gimnasio y no sabes que hacer y tampoco como alimentarte, pues yo te ayudo.
        </p>
      </div>
      <div class="flex gap-4 mt-6 justify-center lg:justify-start items-center">
        <p class="font-semibold hidden lg:block">Sígueme por:</p>
        <ButtonSocialLink
          title="Facebook"
          href="https://www.facebook.com/profile.php?id=100087054653965"
          bg="md:bg-white bg-primary"
          className="hover:text-green-700 text-black md:hover:text-blue-800"
        >
          <FacebooIcon />
        </ButtonSocialLink>
        <ButtonSocialLink
          title="Instagram"
          href="https://www.instagram.com/danielkelly_fit/"
          bg="md:bg-white bg-primary"
          className="hover:text-green-700 text-black md:hover:text-[#9C7594]"
        >
          <InstagramIcon />
        </ButtonSocialLink>
        <ButtonSocialLink
          title="Tik Tok"
          href="https://www.tiktok.com/@danielkellys?lang=es-419"
          bg="md:bg-white bg-primary"
          className="hover:text-green-700 text-black md:hover:text-black"
        >
          <TikTokIcon />
        </ButtonSocialLink>
      </div>
    </header>
    <div
      class="absolute bottom-0 left-1/2 -translate-x-1/2 flex items-center justify-center lg:right-20 lg:left-auto lg:translate-x-0 lg:z-10"
    >
      <img
        src="/images/daniel_hero.webp"
        class="object-cover h-[600px] md:h-[570px] xl:h-[680px] 2xl:h-[700px] right-12 bottom-0 select-none z-10"
        alt="Foto de Daniel Kelly"
      />
      <svg
        viewBox="0 0 200 200"
        xmlns="http://www.w3.org/2000/svg"
        class="absolute bottom-10 scale-125"
      >
        <path
          fill="#FFF"
          d="M44.7,-68.8C59.7,-59.8,75,-50.5,83,-36.8C91,-23,91.8,-4.9,87.6,11.3C83.3,27.5,74,41.8,62.5,53.1C51,64.3,37.4,72.7,22.9,76C8.5,79.2,-6.9,77.4,-20.9,72.6C-34.9,67.8,-47.6,60.1,-59.4,49.7C-71.2,39.3,-82.1,26.3,-84.6,11.9C-87.1,-2.6,-81.2,-18.5,-71.7,-30C-62.1,-41.5,-48.9,-48.5,-36.4,-58.6C-23.8,-68.7,-11.9,-81.8,1.5,-84C14.8,-86.3,29.6,-77.7,44.7,-68.8Z"
          transform="translate(100 100)"></path>
      </svg>
    </div>
  </div>
  <div class="absolute w-full h-full top-0 left-0 z-20 bg-black/90 lg:bg-white/5"></div>
</section>
