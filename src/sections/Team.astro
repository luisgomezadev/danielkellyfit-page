---
import ButtonSocialLink from '@/components/ButtonSocialLink.astro';
import InstagramIcon from '@/assets/icons/InstagramIcon.astro';

import SwiperGallery from '@/components/SwiperGallery.vue';

const sliderImages = [
  '/images/team/team_1.webp',
  '/images/team/team_2.webp',
  '/images/team/team_3.webp',
  '/images/team/team_4.webp',
  '/images/team/team_5.webp',
  '/images/team/team_6.webp',
  '/images/team/team_7.webp',
  '/images/team/team_8.webp',
  '/images/team/team_9.webp',
  '/images/team/team_10.webp',
];

const { id } = Astro.props;
---

<section id={id} class="bg-secondary text-black py-14 md:py-20 scroll-mt-6">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-16 md:px-8 px-4">
    <div class="flex-1">
      <h2
        class="uppercase text-2xl md:text-4xl font-bold mb-1 text-slate-100 md:text-start text-center"
      >
        Team Daniel Kelly
      </h2>
      <h3 class="font-semibold text-primary mb-4 md:text-start text-center">
        Transforma tu cuerpo y mente.
      </h3>
      <p class="text-slate-300 mb-3 leading-relaxed">
        Con mi enfoque en instrucción deportiva y acondicionamiento físico, te ayudo a alcanzar tus
        objetivos de forma efectiva, segura y sostenible.
      </p>
      <p class="text-slate-300 mb-3 leading-relaxed">
        Trabajo contigo para mejorar tu rendimiento, composición corporal, fuerza, resistencia y
        bienestar general, teniendo en cuenta tus necesidades, nivel de experiencia y estilo de
        vida.
      </p>
      <p class="text-slate-300 mb-3 leading-relaxed">
        Ofrezco coaching online y presencial, combinando planificación nutricional, rutinas
        personalizadas y seguimiento continuo para garantizar tu progreso. Cada programa está
        diseñado para adaptarse a tus objetivos, ya sea pérdida de peso, ganancia muscular, mejora
        de la salud o preparación para competiciones.
      </p>
      <p class="text-slate-300 mb-3 leading-relaxed">
        Aquí puedes ver algunas de las transformaciones reales de mis alumnos, que reflejan no solo
        cambios físicos, sino también mejoras en su confianza y hábitos de vida.
      </p>

      <div class="flex gap-4 flex-wrap mt-6">
        <ButtonSocialLink
          title="Instagram teamdanielkelly"
          href="https://www.instagram.com/teamdanielkelly/"
          bg="bg-primary hover:bg-primary/80"
          className="text-black px-6 py-2"
        >
          <InstagramIcon />teamdanielkelly
        </ButtonSocialLink>
      </div>
    </div>
    <div class="w-full max-w-md 2xl:max-w-lg mx-auto">
      <div class="w-full max-w-md 2xl:max-w-lg mx-auto rounded-lg overflow-hidden">
        <SwiperGallery client:only="vue" images={sliderImages} />
      </div>
    </div>
  </div>
</section>
<script type="module">
  const images = document.querySelectorAll('#slider img');
  let current = 0;

  function showSlide(index) {
    images.forEach((img, i) => {
      img.style.opacity = i === index ? '1' : '0';
    });
  }

  // ⬅️ Exponer función prevImage al scope global
  window.prevImage = function () {
    current = (current - 1 + images.length) % images.length;
    showSlide(current);
  };

  // ➡️ Exponer función nextImage al scope global
  window.nextImage = function () {
    current = (current + 1) % images.length;
    showSlide(current);
  };

  // Mostrar primer slide al cargar
  showSlide(current);
</script>
