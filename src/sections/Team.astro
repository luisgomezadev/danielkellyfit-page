---
import ButtonSocialLink from '@/components/ButtonSocialLink.astro';
import InstagramIcon from '@/assets/icons/InstagramIcon.astro';
import SwiperGallery from '@/components/SwiperGallery.vue';
import CheckIcon from '@/assets/icons/CheckIcon.astro';

const sliderImages = [
  '/images/team/team_1.webp',
  '/images/team/team_2.webp',
  '/images/team/team_3.webp',
  '/images/team/team_4.webp',
  '/images/team/team_5.webp',
  '/images/team/team_6.webp',
  '/images/team/team_7.webp',
  '/images/team/team_8.webp',
  '/images/team/team_9.webp',
  '/images/team/team_10.webp',
];

const { id } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-20 bg-[#111] py-16 lg:py-24 text-white timeline-view animate-fade-in animate-range-[entry_5%_contain_10%]"
>
  <div
    class="max-w-7xl mx-auto px-4 lg:px-8 flex flex-col lg:flex-row gap-16 items-center"
  >
    <!-- Información -->
    <div class="flex-1 max-w-2xl">
      <span
        class="inline-block rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-primary"
      >
        Transformaciones reales
      </span>

      <h2
        class="mt-5 text-4xl font-extrabold"
      >
        Team Daniel Kelly
      </h2>

      <p
        class="mt-6 text-lg leading-8 text-gray-300"
      >
        Cada persona tiene un punto de partida diferente. Mi trabajo consiste
        en diseñar un plan adaptado a tus objetivos y acompañarte durante todo
        el proceso para que consigas resultados reales y sostenibles.
      </p>

      <div class="mt-8 space-y-5">
        <div class="flex gap-3">
          <span class="text-primary text-xl"><CheckIcon /></span>
          <p class="text-gray-300">
            Entrenamiento presencial y online.
          </p>
        </div>

        <div class="flex gap-3">
          <span class="text-primary text-xl"><CheckIcon /></span>
          <p class="text-gray-300">
            Rutinas y alimentación completamente personalizadas.
          </p>
        </div>

        <div class="flex gap-3">
          <span class="text-primary text-xl"><CheckIcon /></span>
          <p class="text-gray-300">
            Seguimiento constante para garantizar tu progreso.
          </p>
        </div>
      </div>

      <blockquote
        class="mt-10 border-l-4 border-primary pl-5 italic text-lg text-gray-200"
      >
        Las imágenes que ves corresponden a alumnos que confiaron en el proceso
        y transformaron su estilo de vida.
      </blockquote>

      <div class="flex gap-4 flex-wrap mt-6">
        <ButtonSocialLink
          title="Instagram Team Daniel Kelly"
          href="https://www.instagram.com/teamdanielkelly/"
          bg="bg-primary hover:bg-primary/90"
          className="text-black px-6 py-3 font-semibold"
        >
          <InstagramIcon />
          @teamdanielkelly
        </ButtonSocialLink>
      </div>
    </div>

    <!-- Slider -->
    <div class="w-full max-w-md xl:max-w-lg">
      <div
        class="overflow-hidden rounded-3xl border border-white/10 shadow-2xl"
      >
        <SwiperGallery
          client:only="vue"
          images={sliderImages}
        />
      </div>
    </div>
  </div>
</section>