---
import PricingCard from "@/components/PricingCard.astro";
import TitleSection from "@/components/TitleSection.astro";
import { strategies } from "@/data/strategies.ts";
import { WHATSAPP_NUMBER } from "@/data/constans.ts";

const { id } = Astro.props;

const getWhatsappLink = (plan: string) =>
  `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(
    `Hola Daniel, me interesa iniciar la ${plan}. ¿Me das más información?`
  )}`;


---

<section
  id={id}
  class="bg-background-secondary py-16 lg:py-24 text-accent"
>
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <TitleSection subtitle="inversión">
      Elige tu <span class="text-primary">estrategia</span>
    </TitleSection>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-12 items-stretch">
      {
        strategies.map((strategy) => (
          <PricingCard
            title={strategy.title}
            duration={strategy.duration}
            priceCop={strategy.priceCop}
            priceUsdEur={strategy.priceUsdEur}
            savingsText={strategy.savingsText}
            features={strategy.features}
            isPopular={strategy.isPopular}
            whatsappLink={getWhatsappLink(strategy.whatsappPlanName)}
          />
        ))
      }
    </div>
  </div>
</section>