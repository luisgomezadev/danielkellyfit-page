---
import CheckIcon from "@/assets/icons/CheckIcon.astro";
import TitleSection from "@/components/TitleSection.astro";
import { steps, targetItems, type Step } from "@/data/methods.ts";

const { id } = Astro.props;
---

<section
  id={id}
  class="bg-background-theme py-16 lg:py-24 text-accent"
>
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <div class="mb-24 md:mb-32">
      <TitleSection subtitle="Cómo funciona ">
        La <span class="text-primary">estrategia</span>
      </TitleSection>

      <div class="space-y-8 mt-12">
      {
        steps.map((step: Step, index: number) => {
          const isLast = index === steps.length - 1;
          return (
            <div class="space-y-8">
              <div class="flex items-start gap-4 sm:gap-6">
                <div class="flex-shrink-0 w-10 h-10 sm:w-11 sm:h-11 rounded-full border border-white/20 flex items-center justify-center mt-1">
                  <span class="text-xs sm:text-sm font-display tracking-wider text-primary">
                    {step.stepNumber}
                  </span>
                </div>

                <div class="space-y-2">
                  <h3 class="text-xl sm:text-2xl font-display font-bold tracking-wider uppercase text-white">
                    {step.title}
                  </h3>
                  <p class="text-accent opacity-70 text-sm sm:text-base leading-relaxed">
                    {step.description}
                  </p>
                </div>
              </div>

              {!isLast && <div class="border-b border-zinc-800/80 w-full" />}
            </div>
          );
        })
      }
      </div>
    </div>

    <div>
      <TitleSection subtitle="¿Es para ti?">
        Esta estrategia es tuya <span class="text-primary">si...</span>
      </TitleSection>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1 mt-12 overflow-hidden">
        {
          targetItems.map((item: string) => (
            <div class="bg-background-card p-6 flex items-start gap-1 transition-colors duration-300 hover:bg-background-hero">
              <div class="w-5 h-5 shrink-0 flex items-center justify-center mt-0.5">
                <CheckIcon class="text-primary w-full h-full" />
              </div>
              <p class="text-sm text-accent opacity-70 leading-snug">
                {item}
              </p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>