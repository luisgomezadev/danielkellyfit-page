---
import ServicesCard from '@/components/ServicesCard.astro';
import ButtonSocialLink from '@/components/ButtonSocialLink.astro';
import FacebooIcon from '../assets/icons/FacebookIcon.astro';
import InstagramIcon from '../assets/icons/InstagramIcon.astro';
import WhatsappIcon from '../assets/icons/WhatsappIcon.astro';

const { id } = Astro.props;
---

<section class="bg-primary/80 scroll-mt-16 py-14 md:py-20" id={id}>
  <div class="max-w-7xl mx-auto md:px-8 px-4">
    <h2 class="uppercase text-2xl md:text-4xl font-bold text-black text-center mb-4">
      Mis servicios
    </h2>
    <p class="text-black mb-6 max-w-3xl mx-auto text-center">
      Como entrenador personal, ofrezco programas personalizados enfocados en resultados reales,
      sostenibles y adaptados a tus necesidades. Ya sea que entrenes en casa, en el gimnasio o de
      forma online, tengo un plan para ti. Para más información o consultas, puedes contactarme a
      través de mis redes sociales. Estaré encantado de ayudarte.
    </p>
    <div class="grid gap-4 lg:grid-cols-3 grid-cols-1 min-h-[250px]">
      <div>
        <ServicesCard
          title="Entrenamiento Personalizado"
          description="Plan de entrenamiento 100% adaptado a tus objetivos, condición física y estilo de vida. Incluye seguimiento, ajustes y asesoría continua."
        >
          <img
            src="/images/gym.webp"
            class="absolute w-full h-full top-0 left-0 object-cover select-none"
            alt="Gym"
          />
        </ServicesCard>
      </div>
      <div>
        <ServicesCard
          title="Asesoría Nutricional"
          description="Guía de hábitos alimenticios saludables para complementar tu entrenamiento. Aprenderás a comer mejor sin dietas extremas."
          span="row-span-2"
        >
          <img
            src="/images/nutrition.webp"
            class="absolute w-full h-full top-0 left-0 object-cover select-none"
            alt="Nutrición"
          />
        </ServicesCard>
      </div>
      <div>
        <ServicesCard
          title="Guía de Suplementos"
          description="Te ayudo a identificar cuáles suplementos realmente necesitas según tus objetivos, tipo de entrenamiento y estilo de vida."
        >
          <img
            src="/images/supplements.webp"
            class="absolute w-full h-full top-0 left-0 object-cover select-none"
            alt="Suplementos"
          />
        </ServicesCard>
      </div>
    </div>
  </div>
</section>
