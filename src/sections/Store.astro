---
import ButtonSocialLink from '@/components/ButtonSocialLink.astro';
import InstagramIcon from '@/assets/icons/InstagramIcon.astro';

const { id } = Astro.props;
---

<section id={id} class="bg-background-theme text-white py-14 md:py-20 scroll-mt-10">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row gap-16 md:px-8 px-4">
    <div class="flex-1">
      <span
        class="inline-block rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-primary"
      >
        Ropa deportiva
      </span>

      <h2
        class="mt-5 text-2xl md:text-4xl font-bold text-slate-100"
      >
        Tienda Dekaa.fit
      </h2>

      <p class="mt-6 text-slate-300 leading-relaxed">
        Entrena con prendas diseñadas para ofrecer
        <span class="font-semibold text-white">comodidad, rendimiento y estilo</span>.
        En Dekaa.fit encontrarás conjuntos deportivos, franelas y pantalonetas para
        acompañarte dentro y fuera del gimnasio.
      </p>

      <p class="mt-4 text-slate-300 leading-relaxed">
        Diferentes colores, modelos y tallas para que entrenes con la misma confianza
        con la que buscas alcanzar tus objetivos.
      </p>

      <blockquote class="mt-6 border-l-4 border-primary pl-4 italic text-primary">
        “No es solo entrenar cómodo, también es verse bien.”
      </blockquote>

      <div class="flex gap-4 flex-wrap mt-6">
        <ButtonSocialLink
          title="Instagram Dekaa.fit"
          href="https://www.instagram.com/dekaa.fit/"
          bg="bg-primary hover:bg-primary/80"
          className="text-black font-semibold px-6 py-3"
        >
          <InstagramIcon />
          @dekaa.fit
        </ButtonSocialLink>
      </div>
    </div>

    <!-- Galería -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-3 max-w-3xl">
      <div class="grid gap-3">
        <div class="overflow-hidden h-80 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/conjunto_1.webp"
            alt="Conjunto turquesa Dekaa.fit"
          />
        </div>

        <div class="overflow-hidden h-60 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/franela_1.webp"
            alt="Franela deportiva Dekaa.fit"
          />
        </div>
      </div>

      <div class="grid gap-3">
        <div class="overflow-hidden h-64 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/pantalonetas_2.webp"
            alt="Pantalonetas deportivas Dekaa.fit"
          />
        </div>

        <div class="overflow-hidden h-80 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/conjunto_2.webp"
            alt="Conjunto rosa Dekaa.fit"
          />
        </div>
      </div>

      <div class="hidden lg:grid gap-3">
        <div class="overflow-hidden h-80 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/conjunto_3.webp"
            alt="Conjunto deportivo Dekaa.fit"
          />
        </div>

        <div class="overflow-hidden h-60 rounded-xl">
          <img
            class="object-cover h-full w-full transition duration-500 hover:scale-105 select-none"
            src="images/store/franela_2.webp"
            alt="Franela roja Dekaa.fit"
          />
        </div>
      </div>
    </div>
  </div>
</section>