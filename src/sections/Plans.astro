---
import CheckIcon from '@/assets/icons/CheckIcon.astro';

const { id } = Astro.props;
---

<section
  id={id}
  class="scroll-mt-8 bg-[#111] py-20 text-white"
>
  <div class="max-w-7xl mx-auto px-4 lg:px-8">

    <!-- Encabezado -->
    <div class="max-w-3xl mx-auto text-center">
      <span
        class="inline-block rounded-full border border-primary/30 bg-primary/10 px-4 py-2 text-sm font-medium text-primary"
      >
        Planes de entrenamiento
      </span>

      <h2 class="mt-5 text-4xl lg:text-5xl font-extrabold">
        Elige el plan ideal para ti
      </h2>

      <p class="mt-5 text-lg text-gray-400">
        Escoge el plan que mejor se adapte a tus objetivos y empieza hoy mismo
        tu transformación.
      </p>
    </div>

    <!-- Cards -->
    <div class="grid lg:grid-cols-2 gap-8 mt-16">

      <!-- Premium -->
      <article
        class="flex flex-col rounded-3xl border border-white/10 bg-zinc-900 p-8 transition-all duration-300 hover:border-primary hover:-translate-y-1"
      >
        <span
          class="inline-block w-fit rounded-full bg-blue-500/20 text-blue-300 px-4 py-2 text-sm font-semibold"
        >
          Plan Premium
        </span>

        <h3 class="mt-6 text-5xl font-black">
          $250.000
        </h3>

        <p class="mt-2 text-gray-400">
          Ideal para quienes desean un acompañamiento personalizado.
        </p>

        <ul class="mt-10 space-y-4 flex-1">
          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Plan de entrenamiento personalizado
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Acompañamiento por WhatsApp
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Seguimiento continuo
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            No incluye gimnasio
          </li>
        </ul>

        <a
          href="#contacto"
          class="mt-10 w-full rounded-full bg-primary py-4 text-center font-bold text-black transition hover:opacity-90"
        >
          Solicitar plan
        </a>
      </article>

      <!-- VIP -->
      <article
        class="flex flex-col rounded-3xl border border-white/10 bg-zinc-900 p-8 transition-all duration-300 hover:border-primary hover:-translate-y-1"
      >
        <span
          class="inline-block w-fit rounded-full bg-yellow-500/20 text-yellow-300 px-4 py-2 text-sm font-semibold"
        >
          Plan VIP
        </span>

        <h3 class="mt-6 text-5xl font-black">
          $300.000
        </h3>

        <p class="mt-2 text-gray-400">
          El plan más completo para alcanzar tus objetivos.
        </p>

        <ul class="mt-10 space-y-4 flex-1">
          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Plan de entrenamiento personalizado
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Plan de alimentación
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Guía de suplementación
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            Acompañamiento por WhatsApp 24/7
          </li>

          <li class="flex gap-3">
            <span class="text-primary"><CheckIcon /></span>
            No incluye gimnasio
          </li>
        </ul>

        <a
          href="#contacto"
          class="mt-10 w-full rounded-full bg-primary py-4 text-center font-bold text-black transition hover:opacity-90"
        >
          Solicitar plan
        </a>
      </article>

    </div>

  </div>
</section>