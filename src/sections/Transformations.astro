---
import TitleSection from "@/components/TitleSection.astro";

const { id } = Astro.props;

// Genera un array con las 13 imágenes de la carpeta public/images/team/
const galleryImages = Array.from({ length: 16 }, (_, i) => ({
  src: `/images/team/${i + 1}.webp`,
  alt: `Transformación ${i + 1} - Team Daniel Kelly`,
}));
---

<section
  id={id}
  class="bg-background-secondary py-16 lg:py-24 text-accent"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <TitleSection subtitle="Resultados reales">
      Transformaciones
      <span class="block text-accent opacity-60 uppercase text-lg font-normal">
        #TEAMDANIELKELLY
      </span>
    </TitleSection>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 mt-12">
      {
        galleryImages.map((image) => (
          <button
            type="button"
            class="bg-background-card p-3 border border-zinc-800/80 hover:border-primary/40 transition-all duration-300 group flex items-center justify-center overflow-hidden cursor-pointer text-left"
            data-modal-trigger={image.src}
            data-modal-alt={image.alt}
          >
            <div class="w-full aspect-square overflow-hidden bg-black/40 flex items-center justify-center">
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                title={image.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          </button>
        ))
      }
    </div>
  </div>

  <dialog
    id="image-modal"
    class="bg-transparent p-4 sm:p-6 max-w-5xl max-h-[95vh] w-full backdrop:bg-black/85 backdrop:backdrop-blur-sm open:flex open:items-center open:justify-center outline-none m-auto"
  >
    <div class="relative max-w-full max-h-[85vh] flex items-center justify-center overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/50 shadow-2xl">
      <button
        id="close-modal"
        type="button"
        class="absolute top-3 right-3 z-10 w-9 h-9 flex items-center justify-center rounded-full bg-black/60 text-white/80 hover:text-white hover:bg-primary transition-all duration-300 backdrop-blur-md border border-white/10 text-xl font-bold leading-none cursor-pointer ring-primary focus:outline-none"
        aria-label="Cerrar imagen"
      >
        &times;
      </button>

      <img
        id="modal-img"
        src=""
        alt=""
        class="max-w-full max-h-[85vh] w-auto h-auto object-contain rounded-xl transition-opacity duration-200"
      />
    </div>
  </dialog>
</section>

<script>
  const modal = document.getElementById("image-modal") as HTMLDialogElement | null;
  const modalImg = document.getElementById("modal-img") as HTMLImageElement | null;
  const closeBtn = document.getElementById("close-modal");
  const triggers = document.querySelectorAll("[data-modal-trigger]");

  const openModal = (src: string, alt: string) => {
    if (modal && modalImg) {
      // Oculta temporalmente la imagen mientras cambia el src
      modalImg.style.opacity = "0";
      modalImg.src = src;
      modalImg.alt = alt;

      // Una vez la imagen carga (o si está en caché), vuelve a mostrarla suavemente
      if (modalImg.complete) {
        modalImg.style.opacity = "1";
      } else {
        modalImg.onload = () => {
          modalImg.style.opacity = "1";
        };
      }

      modal.showModal();
      document.body.style.overflow = "hidden"; // Previene el scroll del fondo
    }
  };

  const closeModal = () => {
    if (modal) {
      modal.close();
      document.body.style.overflow = ""; // Restaura el scroll
      if (modalImg) {
        modalImg.src = ""; // Limpia el src para evitar flashes en la siguiente apertura
        modalImg.style.opacity = "0";
      }
    }
  };

  triggers.forEach((trigger) => {
    trigger.addEventListener("click", () => {
      const src = trigger.getAttribute("data-modal-trigger");
      const alt = trigger.getAttribute("data-modal-alt") || "";
      if (src) openModal(src, alt);
    });
  });

  closeBtn?.addEventListener("click", closeModal);

  // Cerrar al hacer clic en el backdrop
  modal?.addEventListener("click", (e) => {
    if (e.target === modal) closeModal();
  });

  // Restaurar el scroll si el usuario presiona la tecla ESC
  modal?.addEventListener("cancel", () => {
    document.body.style.overflow = "";
    if (modalImg) {
      modalImg.src = "";
      modalImg.style.opacity = "0";
    }
  });
</script>