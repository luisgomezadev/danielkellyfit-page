---
import TitleSection from "@/components/TitleSection.astro";

const { id } = Astro.props;

// Genera un array con las 13 imágenes de la carpeta public/images/team/
const galleryImages = Array.from({ length: 16 }, (_, i) => ({
  src: `/images/team/${i + 1}.webp`,
  alt: `Transformación ${i + 1} - Team Daniel Kelly`,
}));
---

<section
  id={id}
  class="bg-background-secondary py-16 lg:py-24 text-accent"
>
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <TitleSection subtitle="Resultados reales">
      Transformaciones
      <span class="block text-accent opacity-60 uppercase text-lg font-normal">
        #TEAMDANIELKELLY
      </span>
    </TitleSection>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4 mt-12">
      {
        galleryImages.map((image) => (
          <button
            type="button"
            class="bg-background-card p-3 border border-zinc-800/80 hover:border-primary/40 transition-all duration-300 group flex items-center justify-center overflow-hidden text-left"
            data-modal-trigger={image.src}
            data-modal-alt={image.alt}
          >
            <div class="w-full aspect-square overflow-hidden bg-black/40 flex items-center justify-center">
              <img
                src={image.src}
                alt={image.alt}
                loading="lazy"
                decoding="async"
                title={image.alt}
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500"
              />
            </div>
          </button>
        ))
      }
    </div>
  </div>
</section>