---
interface Props {
  id?: string;
  whatsappNumber?: string;
  whatsappMessage?: string;
}

const {
  id,
  whatsappNumber = "573022071208", // Reemplazar con tu número de WhatsApp
  whatsappMessage = "Hola! Quiero obtener más información sobre la estrategia #TEAMDANIELKELLY",
} = Astro.props;

const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---

<section
  id={id}
  class="bg-background-theme py-20 lg:py-32 text-center text-accent relative overflow-hidden"
>
  <div
    class="absolute -bottom-24 left-1/2 -translate-x-1/2 w-[500px] sm:w-[700px] h-[250px] sm:h-[350px] bg-primary/20 blur-[100px] sm:blur-[140px] rounded-full pointer-events-none z-0"
    aria-hidden="true"
  ></div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 relative z-10">
    <h2 class="text-3xl sm:text-5xl lg:text-6xl font-display font-extrabold tracking-wide uppercase leading-tight text-white">
      ¿Estás listo para hacer parte del <br class="hidden sm:inline" />
      <span class="text-primary block sm:inline mt-2 sm:mt-0 tracking-wider">#TEAMDANIELKELLY?</span>
    </h2>

    <div class="pt-4 flex justify-center">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#20bd5a] text-accent font-bold uppercase tracking-wider text-sm sm:text-base px-8 py-4 transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 shadow-lg shadow-[#25D366]/10"
      >
        <svg
          class="w-6 h-6 fill-current"
          viewBox="0 0 24 24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M19.05 4.91A9.816 9.816 0 0 0 12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01zm-7.01 15.24h-.01c-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.15.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.15-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.15.17-.25.25-.42.08-.17.04-.31-.02-.43s-.56-1.35-.77-1.85c-.2-.48-.41-.42-.56-.43h-.48c-.17 0-.43.06-.66.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.44.53.6.19 1.15.16 1.59.1.49-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.06-.11-.22-.18-.47-.3z"
          ></path>
        </svg>
        Escribirme Ahora
      </a>
    </div>
  </div>
</section>