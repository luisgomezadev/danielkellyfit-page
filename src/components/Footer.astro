---
import FacebookIcon from '@/assets/icons/FacebookIcon.astro';
import InstagramIcon from '@/assets/icons/InstagramIcon.astro';
import TikTokIcon from '@/assets/icons/TikTokIcon.astro';
---

<footer class="bg-[#111] text-slate-200 opacity-70 text-sm py-8">
  <div class="md:px-8 px-4 flex justify-center mb-8">
    <img src="/images/logo.webp" class="w-32 md:w-52 object-contain" alt="Logo Daniel Kelly Fit" />
  </div>
  <div
    class="max-w-7xl mx-auto flex flex-col md:flex-row gap-x-12 gap-y-6 md:px-8 px-4 justify-between items-center"
  >
    <div class="flex items-center gap-5 text-xl">
      <a href="#perfil" class="flex items-center gap-1"> Perfil </a>
      <a href="#team" class="flex items-center gap-1"> Team </a>
      <a href="#servicios" class="flex items-center gap-1"> Servicios </a>
      <a href="#tienda" class="flex items-center gap-1"> Tienda </a>
      <a href="#eventos" class="flex items-center gap-1"> Eventos </a>
    </div>

    <div class="flex items-center gap-5 text-xl">
      <a href="https://www.instagram.com/danielkelly_fit/" target="_blank">
        <InstagramIcon />
      </a>
      <a href="https://www.facebook.com/profile.php?id=100087054653965" target="_blank">
        <FacebookIcon />
      </a>
      <a href="https://www.tiktok.com/@danielkellys?lang=es-419" target="_blank">
        <TikTokIcon />
      </a>
    </div>
  </div>
  <div
    class="max-w-7xl mx-auto flex flex-col-reverse md:flex-row gap-x-12 gap-y-6 md:px-8 px-4 justify-between items-center border-t border-white/5 mt-6 pt-4 text-center text-xs text-slate-300"
  >
    <span>© 2025 Daniel Kelly | Todos los derechos reservados.</span>
    <span
      >Desarrollado por <a href="https://luisgomezdev.vercel.app/" target="_blank">Luis Gómez</a
      ></span
    >
  </div>
</footer>
