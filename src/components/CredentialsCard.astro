---
const { experience, description } = Astro.props;
---

<div
    class="bg-background-card py-4 px-6 border-l-2 border-transparent hover:border-primary transition-all duration-300 w-full flex flex-col gap-2"
>
    <span class="text-6xl text-primary font-display">{experience}</span>
    <span class="uppercase opacity-60 text-xs">{description}</span>
</div>
