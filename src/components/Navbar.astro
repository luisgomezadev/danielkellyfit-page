---
import ProfileIcon from '@/assets/icons/ProfileIcon.astro';
import ServicesIcon from '@/assets/icons/ServicesIcon.astro';
import StoreIcon from '@/assets/icons/StoreIcon.astro';
import EventsIcon from '@/assets/icons/EventsIcon.astro';
import TransformIcon from '@/assets/icons/TransformIcon.astro';
import MenuIcon from '@/assets/icons/MenuIcon.astro';
import CloseIcon from '@/assets/icons/CloseIcon.astro';
---

<script>
  let isOpen = false;

  (window as any).toggleMenu = function () {
    isOpen = !isOpen;
    const menu = document.getElementById('mobileMenu');
    if (menu) {
      menu.classList.toggle('translate-x-full');
      menu.classList.toggle('translate-x-0');
    }
  };
</script>

<header class="fixed top-0 left-0 w-full bg-slate-100 shadow-md z-50 py-3">
  <div class="max-w-7xl mx-auto px-3">
    <div class="flex items-center justify-between h-12">
      <a href="#inicio" aria-label="Inicio">
        <img
          src="/images/dk_logo_black_transparent.webp"
          class="w-12 hidden md:block"
          alt="Logo Daniel Kelly Fit"
        />
        <div class="block md:hidden bg-black rounded-sm">
          <img src="/images/logo.webp" class="w-24 object-contain" alt="Logo Daniel Kelly Fit" />
        </div>
      </a>

      <nav class="hidden md:flex gap-x-6 md:gap-x-12">
        <a
          href="#perfil"
          class="flex items-center gap-1 text-slate-800 hover:text-green-600 transition"
        >
          Perfil
        </a>
        <a
          href="#servicios"
          class="flex items-center gap-1 text-slate-800 hover:text-green-600 transition"
        >
          Servicios
        </a>
        <a
          href="#team"
          class="flex items-center gap-1 text-slate-800 hover:text-green-600 transition"
        >
          Team
        </a>
        <a
          href="#tienda"
          class="flex items-center gap-1 text-slate-800 hover:text-green-600 transition"
        >
          Tienda
        </a>
        <a
          href="#eventos"
          class="flex items-center gap-1 text-slate-800 hover:text-green-600 transition"
        >
          Eventos
        </a>
      </nav>

      <button onclick="toggleMenu()" class="md:hidden text-slate-800 mr-3">
        <MenuIcon size="32" />
      </button>
    </div>

    <div
      id="mobileMenu"
      class="fixed top-0 right-0 w-full h-screen bg-white/95 text-black flex flex-col items-center justify-center gap-8 text-2xl font-medium transform translate-x-full transition-transform duration-500 md:hidden z-40 backdrop-blur-3xl"
    >
      <button class="absolute top-6 right-6" onclick="toggleMenu()"><CloseIcon size="24" /></button>
      <a href="#perfil" onclick="toggleMenu()" class="flex items-center gap-1 text-gray-800">
        Perfil</a
      >
      <a href="#servicios" onclick="toggleMenu()" class="flex items-center gap-1 text-gray-800"
        >Servicios</a
      >
      <a href="#team" onclick="toggleMenu()" class="flex items-center gap-1 text-gray-800">Team</a>
      <a href="#tienda" onclick="toggleMenu()" class="flex items-center gap-1 text-gray-800"
        >Tienda</a
      >
      <a href="#eventos" onclick="toggleMenu()" class="flex items-center gap-1 text-gray-800"
        >Eventos</a
      >
    </div>
  </div>
</header>
