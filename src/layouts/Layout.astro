---
import Footer from "@/components/Footer.astro";
import { Image } from "astro:assets";
import whatsappIcon from "@/assets/images/WhatsApp.webp";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Soy Daniel Kelly, entrenador personal especializado en transformación física, hábitos saludables y bienestar integral. Agenda tu asesoría personalizada.",
  image = "/images/portada.webp",
} = Astro.props;

const siteUrl = "https://danielkellyfit.vercel.app";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const absoluteImageUrl = new URL(image, siteUrl).toString();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <link rel="icon" href="/images/dk_logo_black_transparent.webp" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/images/dk_logo_transparent.webp" media="(prefers-color-scheme: dark)" />

    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta
      name="keywords"
      content="Daniel Kelly, Personal Trainer, Entrenador Personal, Entrenamiento, Asesoria, Transformación Física, Hábitos Saludables, Bienestar Integral, Fitness, Salud, Nutrición, Ejercicio, Motivación, Coaching, Asesoría Personalizada"
    />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta
      property="og:site_name"
      content="Daniel Kelly | Entrenador Personal"
    />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    <meta property="og:locale" content="es_CO" />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImageUrl} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Person",
        name: "Daniel Kelly",
        jobTitle: "Entrenador Personal",
        description,
        url: siteUrl,
        image: absoluteImageUrl,
        sameAs: ["https://wa.me/573022071208"],
      })}
    />

    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz-wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link
      rel="preload"
      href="/fonts/BebasNeue-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="bg-background-secondary">
    <main>
      <slot />
    </main>
    <Footer />
    
    <a
      href="https://wa.me/573022071208"
      target="_blank"
      rel="noopener noreferrer"
      title="Contáctame por WhatsApp"
      class="fixed bottom-6 right-4 z-40 flex items-center justify-center hover:gap-2 rounded-full bg-[#25D366] p-3 cursor-pointer transition-all duration-300 hover:scale-105"
    >
      <Image
        src={whatsappIcon}
        alt="Icono de WhatsApp"
        width={64}
        height={64}
        format="webp"
        loading="lazy"
        decoding="async"
        class="size-8 object-contain transition-transform duration-300 group-hover:scale-110"
      />
    </a>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-VariableFont_opsz-wght.woff2') format('truetype-variations');
    font-weight: 100 900;
    font-style: normal;
    font-display: swap;
  }

  @font-face {
    font-family: 'Inter';
    src: url('/fonts/Inter-Italic-VariableFont_opsz-wght.woff2') format('truetype-variations');
    font-weight: 100 900;
    font-style: italic;
    font-display: swap;
  }

  @font-face {
    font-family: 'Bebas Neue';
    src: url('/fonts/BebasNeue-Regular.woff2') format('truetype');
    font-weight: 400;
    font-style: normal;
    font-display: swap;
  }

  @tailwind base;
  @tailwind components;
  @tailwind utilities;

  html,
  body {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
    font-family: 'Inter', sans-serif;
  }
</style>