---
import Layout from '@/layouts/Layout.astro';

import Hero from '@/sections/Hero.astro';
import Profile from '@/sections/Profile.astro';
import Services from '@/sections/Services.astro';
import Store from '@/sections/Store.astro';
import Events from '@/sections/Events.astro';
import Team from '@/sections/Team.astro';
import 'aos/dist/aos.css';
---

<Layout title="Daniel Kelly Fit | Entrenador Personal">
  <Hero id="inicio" />
  <Profile id="perfil" />
  <Services id="servicios" />
  <Team id="team" />
  <Store id="tienda" />
  <Events id="eventos" />
</Layout>

<script>
  import AOS from 'aos';

  window.addEventListener('DOMContentLoaded', () => {
    AOS.init({
      duration: 800,
      once: true,
    });
  });
</script>
